<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ThermoNativeReader</AssemblyName>
    <!-- IL Trimming is needed for AOT with external DLLs, but we must be careful -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootDescriptor Include="Roots.xml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ThermoFisher.CommonCore.RawFileReader" Version="8.0.37" />
    <PackageReference Include="ThermoFisher.CommonCore.BackgroundSubtraction" Version="8.0.37" />
    <PackageReference Include="ThermoFisher.CommonCore.Data" Version="8.0.37" />
    <PackageReference Include="ThermoFisher.CommonCore.MassPrecisionEstimator" Version="8.0.37" />
  </ItemGroup>
</Project>
